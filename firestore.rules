rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profiles: any signed-in user can READ all players (needed for the
    // leaderboard / Ranks tab), but a user may only WRITE their own document.
    match /players/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // AI-generated question cache: shared across signed-in users.
    match /ai_questions/{doc} {
      allow read, write: if request.auth != null;
    }

    // Daily/community challenges: shared across signed-in users.
    match /challenges/{doc} {
      allow read, write: if request.auth != null;
    }

    // Per-user AI usage counters — written ONLY by the Cloud Function
    // (Admin SDK bypasses these rules). Clients may never read or write them.
    match /aiUsage/{doc} {
      allow read, write: if false;
    }
  }
}
